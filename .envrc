# Sync .venv from uv.lock and expose it to Emacs/tools via VIRTUAL_ENV + PATH.
# Requires layout_uv in ~/.config/direnv/direnvrc — see udi-plugin-template-pg3x/direnv/direnvrc.example

# EISY/FreeBSD: ruff lacks wheels; maturin build needs Cargo edition2024.
if [ "$(uname -s)" = "FreeBSD" ]; then
  export UV_SYNC_LINT="${UV_SYNC_LINT:-0}"
  export UV_PYTHON="${UV_PYTHON:-/usr/local/bin/python3.11}"
fi

layout uv
